{
  "name": "@jmove/generator",
  "version": "1.2.4",
  "description": "Jazz backing track generator — walking bass, piano comping, drum patterns, and style presets for practice sessions",
  "license": "MIT",
  "author": "JMove",
  "homepage": "https://github.com/JazzMove/jmove-generator#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JazzMove/jmove-generator.git"
  },
  "bugs": {
    "url": "https://github.com/JazzMove/jmove-generator/issues"
  },
  "keywords": [
    "jazz",
    "music",
    "generator",
    "backing-track",
    "walking-bass",
    "piano-comping",
    "drum-patterns",
    "practice",
    "midi",
    "chord-progression"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "validate-preset": "tsx scripts/validate-preset.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22",
    "eslint": "^9",
    "tsup": "^8",
    "typescript": "^5",
    "typescript-eslint": "^8.59.4",
    "tsx": "^4",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
